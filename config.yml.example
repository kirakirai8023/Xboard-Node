# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   type: "singbox"
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only

# Optional forwarding settings (see docs-performance.md):
# kernel:
#   type: "xray"
#   xray_forwarding: "auto"  # compatible keeps managed traffic on the limiter path
#   sniffing: "off"          # route_only; override_destination is Xray-only
#   custom_config: "/etc/xboard-node/kernel.json"

# Optional local certificate management for a panel-managed TLS node:
# cert:
#   source: "local"          # Default: panel-first; local ignores panel cert_config
#   cert_mode: "file"        # Or configure DNS-01 through the deployment wizard
#   domain: "node.example.com"
#   cert_file: "/etc/xboard-node/certs/cert.pem"
#   key_file: "/etc/xboard-node/certs/key.pem"
